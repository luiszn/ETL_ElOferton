      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Audit_Start"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{220D38EC-E237-465F-9D20-D699261BE8E8}"
          SQLTask:SqlStatementSource="INSERT INTO etl.AuditoriaCarga (Paquete, Estado)&#xA;VALUES (N'00_Master', 'EnCurso');&#xA;SELECT CAST(SCOPE_IDENTITY() AS bigint) AS LoadID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="LoadID"
            SQLTask:DtsVariableName="User::LoadID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Audit_Success"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{3D7935EF-45A3-4327-8F7E-9254BD58C561}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Audit_Success"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{220D38EC-E237-465F-9D20-D699261BE8E8}"
          SQLTask:SqlStatementSource="UPDATE etl.AuditoriaCarga&#xA;SET Fin = SYSDATETIME(), Estado = 'Correcto',&#xA;    FilasOrigen    = (SELECT COUNT_BIG(*) FROM stg.Ventas),&#xA;    FilasDestino   = (SELECT COUNT_BIG(*) FROM dw.FactVentas),&#xA;    ImporteOrigen  = (SELECT SUM(ImporteNeto) FROM stg.Ventas),&#xA;    ImporteDestino = (SELECT SUM(ImporteNeto) FROM dw.FactVentas),&#xA;    MensajeError   = NULL&#xA;WHERE CargaID = ?;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::LoadID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
